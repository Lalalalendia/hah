{
  "manifest_version": 3,
  "name": "Yandex RAR Rescue",
  "version": "0.15.5",
  "description": "RAR Rescue: inventory any Yandex web-viewable RAR, sequential downloads and per-archive resume.",
  "permissions": [
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://disk.yandex.ru/*",
    "https://docviewer.yandex.ru/*",
    "https://docviewer.360.yandex.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RAR Rescue - Скачать всё"
  },
  "content_scripts": [
    {
      "matches": [
        "https://disk.yandex.ru/*"
      ],
      "js": [
        "common.js",
        "archive-scope.js",
        "manifest-model.js",
        "recovery-plan.js",
        "harvest-wakeup.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://disk.yandex.ru/*",
        "https://docviewer.yandex.ru/*",
        "https://docviewer.360.yandex.ru/*"
      ],
      "js": [
        "archive-dom.js",
        "archive-crawler.js",
        "archive-navigator.js",
        "frame-sensor.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
